APP_SECRET=1234abcd
CACHE_REFRESH_STDTLL=1860
TEMPLATES_LOCATION=https://raw.githubusercontent.com/HDRUK/traser-mapping-files/dev
SCHEMA_LOCATION=https://raw.githubusercontent.com/HDRUK/schemata-2/dev
HYDRATION_MAP_VERSION="2.2.1"

AUDIT_LOG_ENABLED=0
PUBSUB_PROJECT_ID=hdrinnovationgatewaydev
PUBSUB_TOPIC_NAME=projects/hdrinnovationgatewaydev/topics/gateway-audit-logs-topic
GOOGLE_APPLICATION_CREDENTIALS=/app/application_default_credentials.json

# ── Dataset cache location ──────────────────────────────────────────────────
# Where the disk cache (one {pid}.json per dataset + test-results.json + the
# benchmark/ dir) lives. Defaults to ./data. On a VM, point this at a separate
# mounted volume so the cache can't fill the app/OS disk.
# DATA_DIR=./data
# GATEWAY_API_URL=https://api.prod.hdruk.cloud/api/v2

# ── Cache retention (bounds disk growth on the VM) ──────────────────────────
# A daily background sweep enforces these. The dataset cache is derived and
# re-fetchable — evicting a {pid}.json just means the next "Refresh All"
# re-downloads it. Set a TTL to 0 to disable that particular sweep.
DATA_CACHE_TTL_DAYS=7        # delete {pid}.json dataset files older than N days (by mtime)
BENCHMARK_TTL_DAYS=30        # delete completed benchmark runs older than N days (by completedAt)
RESULT_BODY_TTL_DAYS=3       # strip heavy embedded translate/validate bodies from result cells older than N days
# DATA_MAX_BYTES=             # optional hard size cap for the dataset cache (bytes); evicts oldest first
# DATA_MAX_FILES=             # optional hard file-count cap for the dataset cache; evicts oldest first

# ── Request limits / hardening ──────────────────────────────────────────────
MAX_BODY_MB=512              # reject request bodies larger than this (old Express limit was 512mb)